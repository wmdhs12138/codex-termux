+/// The name this machine is listed under in the client apps. Android's hostname is always
+/// "localhost", which tells nothing in a list of devices: say "<brand> · Termux" instead,
+/// for example "vivo · Termux".
+pub(super) fn local_server_name() -> String {
+    #[cfg(target_os = "android")]
+    {
+        if let Some(brand) = android_property("ro.product.brand")
+            .or_else(|| android_property("ro.product.manufacturer"))
+        {
+            return format!("{brand} · Termux");
+        }
+    }
+    gethostname().to_string_lossy().trim().to_string()
+}
+
+#[cfg(target_os = "android")]
+fn android_property(name: &str) -> Option<String> {
+    use std::ffi::CString;
+    use std::os::raw::c_char;
+    use std::os::raw::c_int;
+
+    const PROP_VALUE_MAX: usize = 92;
+    unsafe extern "C" {
+        fn __system_property_get(name: *const c_char, value: *mut c_char) -> c_int;
+    }
+    let name = CString::new(name).ok()?;
+    let mut value = [0u8; PROP_VALUE_MAX];
+    let len = unsafe { __system_property_get(name.as_ptr(), value.as_mut_ptr().cast()) };
+    let len = usize::try_from(len).ok().filter(|len| *len > 0)?;
+    let value = std::str::from_utf8(value.get(..len)?).ok()?.trim();
+    (!value.is_empty()).then(|| value.to_string())
+}
+
