diff --git a/codex-rs/utils/pty/src/android_net_seccomp.rs b/codex-rs/utils/pty/src/android_net_seccomp.rs
new file mode 100644
index 0000000..9de89f7
--- /dev/null
+++ b/codex-rs/utils/pty/src/android_net_seccomp.rs
@@ -0,0 +1,161 @@
+//! In-process `seccomp-bpf` network restriction for Android child processes.
+//!
+//! Android kernels lack Landlock and unprivileged user namespaces, so Linux's bubblewrap sandbox
+//! cannot run. Stacking a `SECCOMP_MODE_FILTER` on top of zygote's app filter still works without
+//! root, letting Codex enforce `network_access = false` at the kernel level for shell commands
+//! while keeping local `AF_UNIX` and `AF_NETLINK` sockets available.
+//!
+//! `install_network_filter` uses a static BPF program with no heap allocation and only two
+//! `prctl(2)` syscalls, so it is async-signal-safe inside `CommandExt::pre_exec`.
+use std::io;
+
+#[cfg(target_arch = "aarch64")]
+#[repr(C)]
+struct SockFilter {
+    code: u16,
+    jt: u8,
+    jf: u8,
+    k: u32,
+}
+
+#[cfg(target_arch = "aarch64")]
+#[repr(C)]
+struct SockFprog {
+    len: u16,
+    filter: *const SockFilter,
+}
+
+#[cfg(target_arch = "aarch64")]
+const fn bpf_stmt(code: u16, k: u32) -> SockFilter {
+    SockFilter {
+        code,
+        jt: 0,
+        jf: 0,
+        k,
+    }
+}
+
+#[cfg(target_arch = "aarch64")]
+const fn bpf_jump(code: u16, k: u32, jt: u8, jf: u8) -> SockFilter {
+    SockFilter { code, jt, jf, k }
+}
+
+// Linux BPF opcode constants (<linux/filter.h>).
+#[cfg(target_arch = "aarch64")]
+const BPF_LD_W_ABS: u16 = 0x20;
+#[cfg(target_arch = "aarch64")]
+const BPF_JMP_JEQ_K: u16 = 0x15;
+#[cfg(target_arch = "aarch64")]
+const BPF_RET_K: u16 = 0x06;
+
+// Linux prctl/seccomp constants (<linux/prctl.h>, <linux/seccomp.h>, <linux/audit.h>).
+#[cfg(target_arch = "aarch64")]
+const PR_SET_SECCOMP: libc::c_int = 22;
+#[cfg(target_arch = "aarch64")]
+const PR_SET_NO_NEW_PRIVS: libc::c_int = 38;
+#[cfg(target_arch = "aarch64")]
+const SECCOMP_MODE_FILTER: libc::c_ulong = 2;
+#[cfg(target_arch = "aarch64")]
+const AUDIT_ARCH_AARCH64: u32 = 0xc000_00b7;
+#[cfg(target_arch = "aarch64")]
+const SECCOMP_RET_ALLOW: u32 = 0x7fff_0000;
+#[cfg(target_arch = "aarch64")]
+const SECCOMP_RET_ERRNO_EPERM: u32 = 0x0005_0000 | (libc::EPERM as u32);
+
+// Offsets into `struct seccomp_data` on little-endian AArch64.
+#[cfg(target_arch = "aarch64")]
+const OFFSET_NR: u32 = 0;
+#[cfg(target_arch = "aarch64")]
+const OFFSET_ARCH: u32 = 4;
+#[cfg(target_arch = "aarch64")]
+const OFFSET_ARG0_LO: u32 = 16;
+#[cfg(target_arch = "aarch64")]
+const OFFSET_ARG0_HI: u32 = 20;
+
+// Frozen AArch64 Linux syscall numbers (<asm-generic/unistd.h>).
+#[cfg(target_arch = "aarch64")]
+const SYS_PTRACE: u32 = 117;
+#[cfg(target_arch = "aarch64")]
+const SYS_SOCKET: u32 = 198;
+#[cfg(target_arch = "aarch64")]
+const SYS_PROCESS_VM_READV: u32 = 270;
+#[cfg(target_arch = "aarch64")]
+const SYS_PROCESS_VM_WRITEV: u32 = 271;
+#[cfg(target_arch = "aarch64")]
+const SYS_IO_URING_SETUP: u32 = 425;
+#[cfg(target_arch = "aarch64")]
+const SYS_IO_URING_ENTER: u32 = 426;
+#[cfg(target_arch = "aarch64")]
+const SYS_IO_URING_REGISTER: u32 = 427;
+
+#[cfg(target_arch = "aarch64")]
+const AF_UNIX: u32 = libc::AF_UNIX as u32;
+#[cfg(target_arch = "aarch64")]
+const AF_NETLINK: u32 = libc::AF_NETLINK as u32;
+
+/// Static BPF program denying non-local socket families, io_uring, and ptrace/process_vm_*.
+///
+/// Indices:
+/// - 0..=1:   verify `arch == AUDIT_ARCH_AARCH64`, else jump to 15 (DENY)
+/// - 2..=9:   dispatch on `nr` (`SYS_SOCKET` -> 10; blocked syscalls -> 15; others -> 16)
+/// - 10..=14: allow `socket(AF_UNIX | AF_NETLINK, ...)`, else 15 (DENY)
+/// - 15:      return `EPERM`
+/// - 16:      allow
+#[cfg(target_arch = "aarch64")]
+static NETWORK_DENY_FILTER: [SockFilter; 17] = [
+    bpf_stmt(BPF_LD_W_ABS, OFFSET_ARCH),                    // 0
+    bpf_jump(BPF_JMP_JEQ_K, AUDIT_ARCH_AARCH64, 0, 13),     // 1 -> 2 | 15
+    bpf_stmt(BPF_LD_W_ABS, OFFSET_NR),                      // 2
+    bpf_jump(BPF_JMP_JEQ_K, SYS_SOCKET, 6, 0),              // 3 -> 10 | 4
+    bpf_jump(BPF_JMP_JEQ_K, SYS_IO_URING_SETUP, 10, 0),     // 4 -> 15 | 5
+    bpf_jump(BPF_JMP_JEQ_K, SYS_IO_URING_ENTER, 9, 0),      // 5 -> 15 | 6
+    bpf_jump(BPF_JMP_JEQ_K, SYS_IO_URING_REGISTER, 8, 0),   // 6 -> 15 | 7
+    bpf_jump(BPF_JMP_JEQ_K, SYS_PTRACE, 7, 0),              // 7 -> 15 | 8
+    bpf_jump(BPF_JMP_JEQ_K, SYS_PROCESS_VM_READV, 6, 0),    // 8 -> 15 | 9
+    bpf_jump(BPF_JMP_JEQ_K, SYS_PROCESS_VM_WRITEV, 5, 6),   // 9 -> 15 | 16
+    bpf_stmt(BPF_LD_W_ABS, OFFSET_ARG0_HI),                 // 10
+    bpf_jump(BPF_JMP_JEQ_K, 0, 0, 3),                       // 11 -> 12 | 15
+    bpf_stmt(BPF_LD_W_ABS, OFFSET_ARG0_LO),                 // 12
+    bpf_jump(BPF_JMP_JEQ_K, AF_UNIX, 2, 0),                 // 13 -> 16 | 14
+    bpf_jump(BPF_JMP_JEQ_K, AF_NETLINK, 1, 0),              // 14 -> 16 | 15
+    bpf_stmt(BPF_RET_K, SECCOMP_RET_ERRNO_EPERM),           // 15: DENY
+    bpf_stmt(BPF_RET_K, SECCOMP_RET_ALLOW),                 // 16: ALLOW
+];
+
+/// Enable `PR_SET_NO_NEW_PRIVS` and attach the Android network-denial seccomp filter to the
+/// calling thread/process. Safe to call inside `CommandExt::pre_exec`.
+#[cfg(target_arch = "aarch64")]
+pub fn install_network_filter() -> io::Result<()> {
+    // SAFETY: `prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0)` is an async-signal-safe syscall with no
+    // pointer arguments.
+    if unsafe { libc::prctl(PR_SET_NO_NEW_PRIVS, 1 as libc::c_ulong, 0 as libc::c_ulong, 0 as libc::c_ulong, 0 as libc::c_ulong) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let prog = SockFprog {
+        len: NETWORK_DENY_FILTER.len() as u16,
+        filter: NETWORK_DENY_FILTER.as_ptr(),
+    };
+    // SAFETY: `prog` points to a `'static` array of valid BPF instructions for the duration of the
+    // syscall; the kernel copies the program before returning.
+    if unsafe {
+        libc::prctl(
+            PR_SET_SECCOMP,
+            SECCOMP_MODE_FILTER,
+            (&raw const prog) as libc::c_ulong,
+            0 as libc::c_ulong,
+            0 as libc::c_ulong,
+        )
+    } != 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(())
+}
+
+#[cfg(not(target_arch = "aarch64"))]
+pub fn install_network_filter() -> io::Result<()> {
+    Err(io::Error::new(
+        io::ErrorKind::Unsupported,
+        "Android network seccomp filter is only implemented for aarch64",
+    ))
+}
