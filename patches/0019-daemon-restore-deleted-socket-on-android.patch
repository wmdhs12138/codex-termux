+/// Event-driven watcher for the daemon's control socket and rendezvous symlink on Android.
+///
+/// If the socket directory or rendezvous link is removed while the daemon keeps running, every
+/// client fails with `No such file or directory` while this process still holds the daemon lock.
+/// Watching the parent directories with `inotify` avoids periodic background wakeups on mobile
+/// and restores the socket immediately; if `inotify` cannot be initialized or restoration fails,
+/// a fallback interval retries every 2 s.
+#[cfg(target_os = "android")]
+struct ControlSocketWatch {
+    inotify: Option<tokio::io::unix::AsyncFd<std::os::fd::OwnedFd>>,
+    fallback: tokio::time::Interval,
+    failing: bool,
+}
+
+#[cfg(target_os = "android")]
+impl ControlSocketWatch {
+    fn new(socket_guard: &DaemonSocketFileGuard) -> Self {
+        let mut fallback = tokio::time::interval(CONTROL_SOCKET_RETRY_INTERVAL);
+        fallback.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Delay);
+        let (inotify, failing) = match init_inotify(socket_guard) {
+            Some((async_fd, armed)) => (Some(async_fd), !armed),
+            None => (None, false),
+        };
+        Self {
+            inotify,
+            fallback,
+            failing,
+        }
+    }
+
+    async fn wait(&mut self) {
+        if self.failing || self.inotify.is_none() {
+            self.fallback.tick().await;
+            return;
+        }
+        let Some(async_fd) = self.inotify.as_ref() else {
+            self.fallback.tick().await;
+            return;
+        };
+        match async_fd.readable().await {
+            Ok(mut guard) => {
+                use std::os::fd::AsRawFd;
+                let fd = async_fd.get_ref().as_raw_fd();
+                let mut buf = [0u8; 4096];
+                loop {
+                    let n = unsafe { libc::read(fd, buf.as_mut_ptr().cast(), buf.len()) };
+                    if n <= 0 {
+                        break;
+                    }
+                }
+                guard.clear_ready();
+            }
+            Err(_) => {
+                self.inotify = None;
+                self.fallback.tick().await;
+            }
+        }
+    }
+
+    async fn check(
+        &mut self,
+        listener: &mut UnixListener,
+        socket_guard: &mut DaemonSocketFileGuard,
+    ) {
+        match restore_control_socket(listener, socket_guard).await {
+            Ok(()) => {
+                let rearmed = self
+                    .inotify
+                    .as_ref()
+                    .is_none_or(|async_fd| arm_inotify_watches(async_fd.get_ref(), socket_guard));
+                self.failing = !rearmed;
+            }
+            // Retried on the fallback interval; report a persistent failure once.
+            Err(err) if !self.failing => {
+                self.failing = true;
+                self.fallback.reset();
+                warn!(%err, "failed to restore the app-server control socket");
+            }
+            Err(_) => {}
+        }
+    }
+}
+
+#[cfg(target_os = "android")]
+fn init_inotify(
+    socket_guard: &DaemonSocketFileGuard,
+) -> Option<(tokio::io::unix::AsyncFd<std::os::fd::OwnedFd>, bool)> {
+    use std::os::fd::FromRawFd;
+    use std::os::fd::OwnedFd;
+
+    let raw = unsafe { libc::inotify_init1(libc::IN_NONBLOCK | libc::IN_CLOEXEC) };
+    if raw < 0 {
+        return None;
+    }
+    let owned = unsafe { OwnedFd::from_raw_fd(raw) };
+    let armed = arm_inotify_watches(&owned, socket_guard);
+    let async_fd = tokio::io::unix::AsyncFd::new(owned).ok()?;
+    Some((async_fd, armed))
+}
+
+#[cfg(target_os = "android")]
+fn arm_inotify_watches(
+    inotify_fd: &std::os::fd::OwnedFd,
+    socket_guard: &DaemonSocketFileGuard,
+) -> bool {
+    use std::ffi::CString;
+    use std::os::fd::AsRawFd;
+    use std::os::unix::ffi::OsStrExt;
+
+    let mask = libc::IN_DELETE | libc::IN_DELETE_SELF | libc::IN_MOVED_FROM | libc::IN_MOVE_SELF;
+    let mut all_ok = true;
+    for dir in [
+        socket_guard.socket_path.as_path().parent(),
+        socket_guard.rendezvous_path.as_path().parent(),
+    ]
+    .into_iter()
+    .flatten()
+    {
+        let Ok(cpath) = CString::new(dir.as_os_str().as_bytes()) else {
+            all_ok = false;
+            continue;
+        };
+        let wd = unsafe { libc::inotify_add_watch(inotify_fd.as_raw_fd(), cpath.as_ptr(), mask) };
+        if wd < 0 {
+            all_ok = false;
+        }
+    }
+    all_ok
+}
+
+#[cfg(target_os = "android")]
+async fn restore_control_socket(
+    listener: &mut UnixListener,
+    socket_guard: &mut DaemonSocketFileGuard,
+) -> IoResult<()> {
+    use std::os::unix::fs::DirBuilderExt;
+
+    let socket_path = socket_guard.socket_path.as_path();
+    match std::fs::symlink_metadata(socket_path) {
+        Ok(_) => {}
+        Err(err) if err.kind() == ErrorKind::NotFound => {
+            // The same steps as at startup, in the same order.
+            codex_uds::prepare_shared_daemon_socket_directory()?;
+            let mut lock = try_acquire_removable_app_server_startup_lock(
+                AbsolutePathBuf::from_absolute_path_checked(socket_path.with_extension("lock"))?,
+            )?;
+            prepare_control_socket_path(socket_path).await?;
+            let restored = UnixListener::bind(socket_path).await?;
+            if let Err(err) = set_control_socket_permissions(socket_path).await {
+                let _ = std::fs::remove_file(socket_path);
+                return Err(err);
+            }
+            lock._file.unlock()?;
+            lock.remove_on_drop = true;
+            *listener = restored;
+            // The old lock's file is gone, so dropping it leaves the new one in place.
+            socket_guard._startup_lock = lock;
+            warn!(
+                socket_path = %socket_path.display(),
+                "app-server control socket was deleted; listening on it again"
+            );
+        }
+        Err(err) => return Err(err),
+    }
+    let rendezvous_path = socket_guard.rendezvous_path.as_path();
+    match std::fs::symlink_metadata(rendezvous_path) {
+        Ok(_) => Ok(()),
+        Err(err) if err.kind() == ErrorKind::NotFound => {
+            if let Some(parent) = rendezvous_path.parent() {
+                match std::fs::DirBuilder::new().mode(0o700).create(parent) {
+                    Ok(()) => {}
+                    Err(err) if err.kind() == ErrorKind::AlreadyExists => {}
+                    Err(err) => return Err(err),
+                }
+            }
+            std::os::unix::fs::symlink(socket_path, rendezvous_path)?;
+            warn!(
+                rendezvous_path = %rendezvous_path.display(),
+                "app-server control socket link was deleted; linked it again"
+            );
+            Ok(())
+        }
+        Err(err) => Err(err),
+    }
+}
