+#[cfg(target_os = "android")]
+fn termux_clipboard_read(deadline: Instant) -> Result<String, String> {
+    use std::io::Read;
+    use std::process::Command;
+    use std::process::Stdio;
+    use std::time::Duration;
+
+    let mut child = Command::new("termux-clipboard-get")
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .map_err(|err| {
+            if err.kind() == std::io::ErrorKind::NotFound {
+                "clipboard text is unavailable (install Termux:API)".to_string()
+            } else {
+                format!("failed to start termux-clipboard-get: {err}")
+            }
+        })?;
+    let max_bytes = MAX_USER_INPUT_TEXT_CHARS * 4 + 1;
+    let reader = child.stdout.take().map(|stdout| {
+        std::thread::spawn(move || -> Result<Vec<u8>, String> {
+            let mut bytes = Vec::new();
+            stdout
+                .take(max_bytes as u64)
+                .read_to_end(&mut bytes)
+                .map_err(|_| "could not read clipboard text".to_string())?;
+            Ok(bytes)
+        })
+    });
+    let status = loop {
+        match child.try_wait() {
+            Ok(Some(status)) => break status,
+            Ok(None) if Instant::now() >= deadline => {
+                let _ = child.kill();
+                let _ = child.wait();
+                if let Some(handle) = reader {
+                    let _ = handle.join();
+                }
+                return Err("clipboard read timed out".into());
+            }
+            Ok(None) => std::thread::sleep(Duration::from_millis(20)),
+            Err(_) => {
+                let _ = child.kill();
+                let _ = child.wait();
+                if let Some(handle) = reader {
+                    let _ = handle.join();
+                }
+                return Err("could not read clipboard text".into());
+            }
+        }
+    };
+    let bytes = match reader {
+        Some(handle) => handle
+            .join()
+            .map_err(|_| "could not read clipboard text".to_string())??,
+        None => Vec::new(),
+    };
+    if !status.success() {
+        return Err("clipboard text is unavailable".into());
+    }
+    if bytes.len() >= max_bytes {
+        return Err("clipboard text exceeds the message size limit".into());
+    }
+    let text = String::from_utf8(bytes).map_err(|_| "clipboard text is not UTF-8")?;
+    validate(text, deadline)
+}
