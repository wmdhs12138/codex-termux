+#[cfg(target_os = "android")]
+fn termux_clipboard_copy(text: &str) -> Result<Option<ClipboardLease>, String> {
+    use std::io::Read;
+    use std::process::Command;
+    use std::process::Stdio;
+    use std::time::Duration;
+    use std::time::Instant;
+
+    let mut child = Command::new("termux-clipboard-set")
+        .stdin(Stdio::piped())
+        .stdout(Stdio::null())
+        .stderr(Stdio::piped())
+        .spawn()
+        .map_err(|err| {
+            if err.kind() == std::io::ErrorKind::NotFound {
+                "termux-clipboard-set not found (install Termux:API)".to_string()
+            } else {
+                format!("failed to start termux-clipboard-set: {err}")
+            }
+        })?;
+    let payload = text.as_bytes().to_vec();
+    let writer = child.stdin.take().map(|mut stdin| {
+        std::thread::spawn(move || {
+            let _ = stdin.write_all(&payload);
+        })
+    });
+    let deadline = Instant::now() + Duration::from_secs(5);
+    let status = loop {
+        match child.try_wait() {
+            Ok(Some(status)) => break status,
+            Ok(None) if Instant::now() >= deadline => {
+                let _ = child.kill();
+                let _ = child.wait();
+                if let Some(handle) = writer {
+                    let _ = handle.join();
+                }
+                return Err("termux-clipboard-set timed out".to_string());
+            }
+            Ok(None) => std::thread::sleep(Duration::from_millis(20)),
+            Err(err) => {
+                let _ = child.kill();
+                let _ = child.wait();
+                if let Some(handle) = writer {
+                    let _ = handle.join();
+                }
+                return Err(format!("termux-clipboard-set wait failed: {err}"));
+            }
+        }
+    };
+    if let Some(handle) = writer {
+        let _ = handle.join();
+    }
+    if status.success() {
+        Ok(None)
+    } else {
+        let mut stderr = String::new();
+        if let Some(mut pipe) = child.stderr.take() {
+            let _ = pipe.read_to_string(&mut stderr);
+        }
+        let detail = stderr.trim();
+        if detail.is_empty() {
+            Err(format!("termux-clipboard-set exited with {status}"))
+        } else {
+            Err(format!("termux-clipboard-set failed: {detail}"))
+        }
+    }
+}
