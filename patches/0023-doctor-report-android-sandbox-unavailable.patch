         summary = "Linux sandbox helper path does not exist".to_string();
     }
 
+    #[cfg(target_os = "android")]
+    {
+        details.push(
+            "platform sandbox: partial on Android (seccomp-bpf network only; no filesystem sandbox)"
+                .to_string(),
