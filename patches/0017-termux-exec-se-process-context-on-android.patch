+/// Read by termux-exec, the `execve` hook Termux preloads into every process. When it is unset,
+/// the hook reads `/proc/self/attr/current` with `fopen()` instead. On Android, std spawns
+/// children with fork + exec, and the hook runs in the forked child before the exec: if another
+/// thread held a libc stdio lock at the fork, the child blocks on it forever, keeping copies of
+/// every descriptor the parent had open (the daemon's control socket included).
+#[cfg(target_os = "android")]
+const TERMUX_SE_PROCESS_CONTEXT_ENV_VAR: &str = "TERMUX__SE_PROCESS_CONTEXT";
+
+/// Exports the SELinux context while the process is still single-threaded, so the hook never
+/// takes that path in a child that inherits the environment.
+#[cfg(target_os = "android")]
+fn export_se_process_context() {
+    if std::env::var_os(TERMUX_SE_PROCESS_CONTEXT_ENV_VAR).is_some_and(|value| !value.is_empty()) {
+        return;
+    }
+    let Ok(raw) = std::fs::read("/proc/self/attr/current") else {
+        return;
+    };
+    if let Some(context) = se_process_context(&raw) {
+        // It is safe to call set_var() because our process is single-threaded at
+        // this point in its execution.
+        unsafe { std::env::set_var(TERMUX_SE_PROCESS_CONTEXT_ENV_VAR, context) };
+    }
+}
+
+/// Returns the context if termux-exec would accept it,
+/// `^u:r:[^\n :]+:s0(:c[0-9]+,c[0-9]+(,c[0-9]+,c[0-9]+)?)?$`. It warns on every exec about
+/// any other value, such as the AppArmor label `/proc/self/attr/current` holds in a container.
+#[cfg(any(target_os = "android", test))]
+fn se_process_context(raw: &[u8]) -> Option<&str> {
+    let context = std::str::from_utf8(raw)
+        .ok()?
+        .trim_end_matches(['\0', '\n']);
+    let (domain, level) = context.strip_prefix("u:r:")?.split_once(':')?;
+    let categories = level.strip_prefix("s0")?;
+    let domain_ok = !domain.is_empty() && !domain.contains([' ', '\n']);
+    let categories_ok = categories.is_empty()
+        || categories.strip_prefix(':').is_some_and(|categories| {
+            let categories = categories.split(',').collect::<Vec<_>>();
+            matches!(categories.len(), 2 | 4)
+                && categories.iter().all(|category| {
+                    category.strip_prefix('c').is_some_and(|number| {
+                        !number.is_empty() && number.bytes().all(|byte| byte.is_ascii_digit())
+                    })
+                })
+        });
+    (domain_ok && categories_ok).then_some(context)
+}
