+            (b"", None),
+            (b"u:r::s0", None),
+            (b"u:r:untrusted_app:s1", None),
+            (b"u:r:untrusted_app:s0:c512", None),
+            (b"u:r:untrusted_app:s0:c512,c768,c1", None),
+            (b"u:r:untrusted_app:s0:c512,x768", None),
+            (b"u:r:untrusted app:s0", None),
+        ] {
+            assert_eq!(se_process_context(raw), expected, "{raw:?}");
+        }
+    }
 }
