+// codex-termux: a re-cut (vX.Y.Z-rN) keeps the version, so it is told apart by binary hash.
+// See termux_build.rs.
+#[cfg(target_os = "android")]
+fn build_changed_since_check(version_file: &Path) -> bool {
+    crate::termux_build::needs_check(version_file)
+}
+
+#[cfg(not(target_os = "android"))]
+fn build_changed_since_check(_version_file: &Path) -> bool {
+    false
+}
+
+#[cfg(target_os = "android")]
+fn rebuilt_version(config: &Config, latest_version: &str) -> Option<String> {
+    crate::termux_build::rebuilt_version(&version_filepath(config), latest_version)
+}
+
+#[cfg(not(target_os = "android"))]
+fn rebuilt_version(_config: &Config, _latest_version: &str) -> Option<String> {
+    None
+}
