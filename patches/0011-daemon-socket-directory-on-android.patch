 use std::os::unix::fs::MetadataExt;
 use std::path::PathBuf;
 
+/// Android has no writable `/tmp`: it is a root-level directory owned by `shell`. Use
+/// `$PREFIX/var/run` rather than `$PREFIX/tmp` because Termux empties `tmp` on app exit while
+/// the daemon outlives it, and `var/run` still keeps the socket path within `sun_path` (91 bytes
+/// with a 128-bit digest). Fall back to `$PREFIX` for custom-package Termux forks.
+#[cfg(target_os = "android")]
+fn temporary_root() -> io::Result<PathBuf> {
+    const TERMUX_USR: &str = "/data/data/com.termux/files/usr";
+    let standard_usr = PathBuf::from(TERMUX_USR);
+    if standard_usr.is_dir() {
+        let var_run = standard_usr.join("var/run");
+        fs::create_dir_all(&var_run)?;
+        return Ok(var_run);
+    }
+    if let Some(prefix) = std::env::var_os("PREFIX") {
+        let prefix_path = PathBuf::from(prefix);
+        if prefix_path.is_dir() {
+            let var_run = prefix_path.join("var/run");
+            if fs::create_dir_all(&var_run).is_ok() {
+                return Ok(var_run);
+            }
+            let tmp = prefix_path.join("tmp");
+            if tmp.is_dir() {
+                return Ok(tmp);
+            }
+        }
+    }
+    Ok(std::env::temp_dir())
+}
+
+#[cfg(not(target_os = "android"))]
+fn temporary_root() -> io::Result<PathBuf> {
+    // Resolve the system alias /tmp -> /private/tmp on macOS.
+    fs::canonicalize("/tmp")
+}
